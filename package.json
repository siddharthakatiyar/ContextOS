{
  "name": "@siddharthakatiyar/contextos",
  "version": "0.9.0",
  "description": "ContextOS - Universal knowledge graph for coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddharthakatiyar/ContextOS.git"
  },
  "type": "module",
  "bin": {
    "contextos": "./dist/bin/contextos.js"
  },
  "main": "dist/src/index.js",
  "workspaces": [
    "docs"
  ],
  "files": [
    "dist/src/",
    "dist/bin/",
    "README.md",
    ".contextosignore.default"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "bench": "tsx scripts/run-benchmarks.ts",
    "generate:large-repo": "tsx tools/generate-large-repo.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-search",
    "semantic-search",
    "rag",
    "retrieval",
    "tree-sitter",
    "ai-agents",
    "coding-assistant",
    "cli"
  ],
  "author": "Siddhartha Katiyar",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "gpt-tokenizer": "^3.4.0",
    "minimatch": "^10.2.5",
    "ora": "^9.4.0",
    "sqlite-vec": "^0.1.9",
    "tree-sitter-wasms": "^0.1.13",
    "update-notifier": "^7.3.1",
    "web-tree-sitter": "^0.22.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.9.2",
    "@types/update-notifier": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "prettier": "^3.9.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.8"
  }
}
